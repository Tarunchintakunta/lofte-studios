# ---------------------------------------------------------------------------
# Løfte Studios — environment template. Copy to `.env.local` and fill in.
# Nothing here is required to run the site locally: every integration degrades
# to a clearly-labelled development stub when its variables are absent.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, sitemap, robots, and OG image URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Enquiry form delivery (Phase 5) ---------------------------------------
# Leave BOTH unset in development. The contact action then logs the submission
# to the server console instead of sending mail. Mail is only ever sent when
# both variables are present, so a stray key alone cannot start real delivery.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Must be a verified sender on the Resend account.
CONTACT_FROM_EMAIL=""

# --- Sanity (Phase 4) ------------------------------------------------------
# Absent = the site reads the local seed content in `src/content/`.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-01-01"
# Server-only. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=""

# --- Analytics (Phase 5) ---------------------------------------------------
# Disabled unless a domain is supplied. No third-party script loads by default.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
